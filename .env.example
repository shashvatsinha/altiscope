# Copy to .env for local development. Never commit .env.

# Postgres (docker compose default)
ALTISCOPE_DATABASE_URL=postgresql://altiscope:altiscope@localhost:5432/altiscope

# LLM provider credentials. The registry in config/models.yaml decides which model
# each stage uses; each provider entry names the environment variable holding its key.
# Any chat-completions-compatible endpoint works (OpenAI, Azure, Ollama, vLLM, ...).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# GitHub ingestion. A GitHub App is the supported path for organizations;
# a personal access token is accepted for single-user evaluation.
ALTISCOPE_GITHUB_APP_ID=
ALTISCOPE_GITHUB_APP_PRIVATE_KEY_PATH=
ALTISCOPE_GITHUB_TOKEN=
# GitHub Enterprise Server: set the API base (default https://api.github.com)
ALTISCOPE_GITHUB_API_BASE=https://api.github.com

# Path to the model registry (see config/examples/ for other layouts)
ALTISCOPE_MODELS_CONFIG=config/models.yaml

# Retention of full LLM request/response payloads (needed for reproducibility;
# may contain source code). "full" | "hashes_only"
ALTISCOPE_LLM_PAYLOAD_RETENTION=full
